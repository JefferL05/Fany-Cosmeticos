# Secrets for the Edge Functions in this folder. Set them with
# `supabase secrets set --env-file supabase/functions/.env` (never commit that file).
# SUPABASE_URL and SUPABASE_ANON_KEY/SUPABASE_SERVICE_ROLE_KEY are injected
# automatically by the platform in deployed functions.

# Mercado Pago sandbox: create a test application and use its TEST- access token.
MERCADO_PAGO_ACCESS_TOKEN=TEST-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Resend: verify a sending domain first, then use its address as RESEND_FROM_EMAIL.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=Fany Cosméticos <pedidos@seudominio.com>

# Public URL of the published store, used for Mercado Pago's return links.
STORE_URL=https://sua-loja-publicada.example
